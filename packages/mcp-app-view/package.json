{
  "name": "@ai37/a2ui-mcp-app",
  "version": "0.51.0",
  "description": "A2UI-поверхность каталога AI37 внутри MCP App: однофайловый HTML-view и помощники протокола _meta[\"ai37/a2ui\"].",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./a2ui-mcp-app.html": "./dist/a2ui-mcp-app.html"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "a2ui",
    "ai37",
    "mcp",
    "mcp-apps"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-37/ai37-a2ui-catalog.git",
    "directory": "packages/mcp-app-view"
  },
  "homepage": "https://github.com/AI-37/ai37-a2ui-catalog#readme",
  "bugs": "https://github.com/AI-37/ai37-a2ui-catalog/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.app.sp-ai.ru/"
  },
  "scripts": {
    "build": "vite build && tsup && node scripts/emit-entry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai37/a2ui-catalog-schemas": "workspace:^"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.1",
    "@a2ui/web_core": "^0.10.1",
    "@ai37/a2ui-catalog-react": "workspace:^",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-react": "^5.1.0",
    "katex": "^0.16.47",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "^4.4.3"
  }
}
