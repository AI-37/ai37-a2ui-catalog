{
  "$ref": "#/definitions/ConstructionsEditor",
  "definitions": {
    "ConstructionsEditor": {
      "type": "object",
      "properties": {
        "constructions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "steny",
                  "pokrytiya",
                  "cherdachnye_podval_grunt",
                  "okna",
                  "fonari",
                  "dver"
                ]
              },
              "subtype": {
                "type": "string",
                "enum": [
                  "cherdak",
                  "podval_vent",
                  "podval_nevent",
                  "pol_po_gruntu"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "material": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "thicknessMm": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": true,
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "material",
                        "vent-gap",
                        "closed-gap"
                      ]
                    },
                    "materialKey": {
                      "type": "string"
                    },
                    "lambdaA": {
                      "type": "number",
                      "exclusiveMinimum": true,
                      "minimum": 0
                    },
                    "lambdaB": {
                      "type": "number",
                      "exclusiveMinimum": true,
                      "minimum": 0
                    },
                    "lambdaManual": {
                      "type": "number",
                      "exclusiveMinimum": true,
                      "minimum": 0
                    }
                  },
                  "required": [
                    "material",
                    "thicknessMm"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "rprPassport": {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              }
            },
            "required": [
              "id",
              "type",
              "layers"
            ],
            "additionalProperties": false
          }
        },
        "typeConfigs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "steny",
                  "pokrytiya",
                  "cherdachnye_podval_grunt",
                  "okna",
                  "fonari",
                  "dver"
                ]
              },
              "label": {
                "type": "string"
              },
              "hasLayers": {
                "type": "boolean"
              },
              "rnorm": {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              },
              "alphaV": {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              },
              "alphaN": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "exclusiveMinimum": true,
                      "minimum": 0
                    },
                    "propertyNames": {
                      "enum": [
                        "cherdak",
                        "podval_vent",
                        "podval_nevent",
                        "pol_po_gruntu"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "type",
              "label",
              "hasLayers"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "condition": {
          "type": "string",
          "enum": [
            "А",
            "Б"
          ]
        },
        "materialsReferenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "minChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "addLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "submitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "submitAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "backLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "backAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "backActionContext": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "constructions",
        "typeConfigs",
        "materialsReferenceId",
        "addLabel",
        "submitLabel",
        "submitAction",
        "backLabel",
        "backAction"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2019-09/schema#"
}
