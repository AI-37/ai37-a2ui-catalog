        "protocol": {
          "type": "object",
          "properties": {
            "meta": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60000
            },
            "downloadFileName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "downloadContent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120000
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        }
