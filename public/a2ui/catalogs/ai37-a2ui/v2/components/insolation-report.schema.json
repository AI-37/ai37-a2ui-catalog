            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "info"
                ]
              },
              "action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                },
                "required": [
                  "name",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
