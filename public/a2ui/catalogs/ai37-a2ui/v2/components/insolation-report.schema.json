            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1
        },
        "inputs": {
          "type": "object",
          "properties": {
            "action": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "payload": {
