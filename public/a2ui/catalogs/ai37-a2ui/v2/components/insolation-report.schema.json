            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail"
              ]
            },
            "badge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "required": [
            "status",
            "badge",
            "headline"
          ],
          "additionalProperties": false
        },
        "timeline": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "axisStart": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "axisEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "ticks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                },
                "required": [
                  "at",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "sun",
                      "shadow"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "from",
                  "to",
                  "kind"
                ],
                "additionalProperties": false
              },
              "minItems": 1
