{
  "$ref": "#/definitions/ProposalCard",
  "definitions": {
    "ProposalCard": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "view": {
          "type": "string",
          "enum": [
            "list",
            "table"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "kind": {
                "type": "string",
                "enum": [
                  "added",
                  "changed",
                  "removed"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "effectiveFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "accepted",
                  "rejected",
                  "stale"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "source": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "quote"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "confirm": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "label",
            "action"
          ],
          "additionalProperties": false
        },
        "canDecide": {
          "type": "boolean"
        },
        "decideLink": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "href": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "label",
            "href"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "proposalId",
        "title",
        "state",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2019-09/schema#"
}
